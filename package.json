  "description": "面向高校开发者的技术问答社区前端, 使用 Vue 3, TypeScript 与 Vite.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
